rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The initial Firebase migration keeps every application document private.
    // Trusted Cloud Functions use the Admin SDK and are not restricted by these
    // client rules. Granular authenticated rules are added with each feature.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
