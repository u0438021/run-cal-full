rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function activeAthlete(workspaceId, athleteId) {
      return request.auth != null
        && request.auth.uid == athleteId
        && firestore.get(/databases/(default)/documents/users/$(athleteId)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/users/$(athleteId)).data.workspaceId == workspaceId
        && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(athleteId)).data.roles.hasAny(['athlete']);
    }

    // The browser can create one opaque staging object for its own athlete ID.
    // Files cannot be read, listed, replaced, or deleted from the browser.
    match /fit-staging/{workspaceId}/{athleteId}/{uploadId} {
      allow create: if activeAthlete(workspaceId, athleteId)
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024;
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
